msgid ""
msgstr "Project-Id-Version: Mail Cleaner 2.0.0\nLanguage: fr_FR\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "100% allows a long signature after a short reply. Empty-result, attachment and GLPI marker protections still apply. Use this limit only with a precisely tested rule."
msgstr "100% autorise une longue signature après une réponse courte. Les protections du résultat vide, des pièces jointes et des marqueurs GLPI restent actives. Utilisez cette limite seulement avec une règle précisément testée."

msgid "A selector exceeds 512 bytes."
msgstr "Un sélecteur dépasse 512 octets."

msgid "After"
msgstr "Après"

msgid "After: %s"
msgstr "Après : %s"

msgid "Before"
msgstr "Avant"

msgid "Before / after preview"
msgstr "Aperçu avant / après"

msgid "CSS selectors to remove (one per line)"
msgstr "Sélecteurs CSS à supprimer (un par ligne)"

msgid "Cannot create capture directory."
msgstr "Impossible de créer le dossier des captures."

msgid "Cannot create capture file."
msgstr "Impossible de créer le fichier de capture."

msgid "Cannot lock capture directory."
msgstr "Impossible de verrouiller le dossier des captures."

msgid "Cannot open capture lock."
msgstr "Impossible d’ouvrir le verrou des captures."

msgid "Capture diagnostics"
msgstr "Diagnostic des captures"

msgid "Capture folder: %s"
msgstr "Dossier des captures : %s"

msgid "Capture write failed: %s"
msgstr "Échec d’écriture de la capture : %s"

msgid "Capture written to: %s"
msgstr "Capture écrite dans : %s"

msgid "Captures contain message bodies, rules and results, including in dry run. Limits: 20 files and 256 KiB per body version. This is not the original MIME email. Disable capture after testing and remove the files after analysis."
msgstr "Les captures contiennent le corps des messages, les règles et les résultats, y compris en simulation. Limites : 20 fichiers et 256 Kio par version du corps. Ce n’est pas le mail MIME original. Désactivez la capture après le test et retirez les fichiers après analyse."

msgid "Clean signatures from collected followups"
msgstr "Nettoyer les signatures des suivis collectés"

msgid "Clean signatures from collected followups and use GLPI theme colors for incoming tickets and followups. Manual entries are excluded."
msgstr "Nettoyez les signatures des suivis collectés et appliquez les couleurs du thème GLPI aux tickets et suivis reçus par mail. Les saisies manuelles sont exclues."

msgid "Cleaning completed"
msgstr "Nettoyage effectué"

msgid "Cleaning rules"
msgstr "Règles de nettoyage"

msgid "Cleaning was skipped because of invalid settings or a processing error."
msgstr "Le nettoyage est ignoré à cause d’une configuration invalide ou d’une erreur de traitement."

msgid "Color normalization failed; the previous content was kept."
msgstr "La normalisation des couleurs a échoué ; le contenu précédent est conservé."

msgid "Colors were kept because normalization would change a protected marker."
msgstr "Les couleurs sont conservées car leur normalisation modifierait un marqueur protégé."

msgid "Could not parse the HTML body"
msgstr "Impossible d’analyser le corps HTML"

msgid "Cut after anchor: also remove quoted history and Outlook reply headers"
msgstr "Coupure après le repère : supprimer aussi l’historique cité et les en-têtes Outlook"

msgid "Cut everything after these CSS anchors (one per line, optional)"
msgstr "Couper tout ce qui suit ces repères CSS (un par ligne, facultatif)"

msgid "Disabled"
msgstr "Désactivée"

msgid "Dry run: keep the original ticket and followup content"
msgstr "Simulation : conserver le contenu original des tickets et suivis"

msgid "Enabled"
msgstr "Activée"

msgid "Examples:"
msgstr "Exemples :"

msgid "GLPI_LOG_DIR is not defined."
msgstr "GLPI_LOG_DIR n’est pas défini."

msgid "HTML is displayed as escaped source. Email scripts, styles and tracking pixels are not executed by this preview."
msgstr "Le HTML est affiché comme code échappé. Cet aperçu n’exécute pas les scripts, styles ni pixels de suivi du mail."

msgid "HTML/XML declaration rejected"
msgstr "Déclaration HTML/XML refusée"

msgid "Hello, the issue is resolved. Thank you for your help."
msgstr "Bonjour, le problème est résolu. Merci pour votre aide."

msgid "Incomplete capture write."
msgstr "Écriture de la capture incomplète."

msgid "Invalid or unsupported CSS selector: %s"
msgstr "Sélecteur CSS invalide ou non pris en charge : %s"

msgid "Kind regards, Alice"
msgstr "Cordialement, Alice"

msgid "Matched content is protected"
msgstr "Le contenu correspondant est protégé"

msgid "Matches"
msgstr "Correspondances"

msgid "Maximum content removed (%)"
msgstr "Part maximale de contenu supprimée (%)"

msgid "Message exceeds the size limit"
msgstr "Le message dépasse la taille limite"

msgid "No capture was written: the 20-file limit was reached or the folder cannot be listed."
msgstr "Aucune capture écrite : la limite de 20 fichiers est atteinte ou le dossier ne peut pas être listé."

msgid "No matching element"
msgstr "Aucun élément correspondant"

msgid "Not requested"
msgstr "Non demandé"

msgid "Paste the HTML received by GLPI after collector processing. Preview works while disabled or in dry run, saves no settings and creates no ticket or followup."
msgstr "Collez le HTML reçu par GLPI après traitement du collecteur. L’aperçu fonctionne même si le nettoyage est désactivé ou en simulation, sans enregistrer la configuration ni créer de ticket ou de suivi."

msgid "Plain text kept unchanged"
msgstr "Texte brut conservé sans modification"

msgid "Preview generated using the displayed rules. Settings were not saved."
msgstr "Aperçu généré avec les règles affichées. La configuration n’a pas été enregistrée."

msgid "Preview without saving"
msgstr "Tester sans enregistrer"

msgid "Processing error"
msgstr "Erreur de traitement"

msgid "Processing options"
msgstr "Options de traitement"

msgid "Protected CSS selectors (one per line)"
msgstr "Sélecteurs CSS protégés (un par ligne)"

msgid "Protected text markers (one per line)"
msgstr "Marqueurs textuels protégés (un par ligne)"

msgid "Pseudo-elements, browser states and :has() are not supported."
msgstr "Les pseudo-éléments, états du navigateur et :has() ne sont pas pris en charge."

msgid "Quotes are protected unless explicit history removal is enabled for cut-after rules. These safeguards cannot identify every meaningful part of an email: test real examples first."
msgstr "Les citations sont protégées sauf si la suppression explicite de l’historique est activée pour la coupure. Ces protections ne reconnaissent pas tout contenu utile : testez d’abord des exemples réels."

msgid "Refusing linked capture directory."
msgstr "Un lien symbolique ne peut pas servir de dossier de capture."

msgid "Refusing linked capture lock."
msgstr "Un lien symbolique ne peut pas servir de verrou de capture."

msgid "Removal deletes the matched element and its children. Cut-after keeps the anchor and removes following content across parent boundaries. Multiple matches for one anchor rule cancel cleaning. Lines starting with // are comments."
msgstr "La suppression retire l’élément ciblé et ses enfants. La coupure conserve le repère et retire le contenu qui suit, même hors de son parent. Plusieurs correspondances pour une règle de repère annulent le nettoyage. Les lignes commençant par // sont des commentaires."

msgid "Removed blocks: %d; protected matches: %d"
msgstr "Blocs supprimés : %d ; correspondances protégées : %d"

msgid "Save settings"
msgstr "Enregistrer la configuration"

msgid "Saved capture setting: %s"
msgstr "Option de capture enregistrée : %s"

msgid "Selector"
msgstr "Sélecteur"

msgid "Sender colors removed; the GLPI theme is inherited"
msgstr "Couleurs de l’expéditeur retirées ; thème GLPI hérité"

msgid "Settings saved."
msgstr "Configuration enregistrée."

msgid "Signature processing: %s"
msgstr "Traitement des signatures : %s"

msgid "Skipped: a protected marker would change"
msgstr "Ignoré : un marqueur protégé serait modifié"

msgid "Skipped: an anchor rule matched more than once"
msgstr "Ignoré : une règle de repère correspond plusieurs fois"

msgid "Skipped: anchor outside the message body"
msgstr "Ignoré : repère hors du corps du message"

msgid "Skipped: more than 100 matched elements"
msgstr "Ignoré : plus de 100 éléments ciblés"

msgid "Skipped: removal limit exceeded"
msgstr "Ignoré : limite de suppression dépassée"

msgid "Skipped: the result would be empty"
msgstr "Ignoré : le résultat serait vide"

msgid "Temporary diagnostics: capture HTML before and after processing (20 files maximum)"
msgstr "Diagnostic temporaire : capturer le HTML avant et après traitement (20 fichiers maximum)"

msgid "Test HTML"
msgstr "HTML de test"

msgid "Test writing a synthetic capture"
msgstr "Tester l’écriture d’une capture fictive"

msgid "The removal limit must be between 1 and 100 percent."
msgstr "La limite de suppression doit être comprise entre 1 et 100 pour cent."

msgid "The selector list is missing or too long."
msgstr "La liste des sélecteurs est absente ou trop longue."

msgid "The test HTML must not exceed 1 MiB."
msgstr "Le HTML de test ne doit pas dépasser 1 Mio."

msgid "Theme colors work independently of signature cleaning. Sender colors, backgrounds and stylesheets are removed so each reader uses their own GLPI theme. Images are not recolored. Existing tickets are unchanged."
msgstr "Les couleurs du thème fonctionnent indépendamment du nettoyage des signatures. Les couleurs, fonds et feuilles de style de l’expéditeur sont retirés pour que chaque lecteur utilise son propre thème GLPI. Les images ne sont pas recolorées. Les tickets existants restent inchangés."

msgid "This confirms write access for the web process, not receipt of an email by the collector."
msgstr "Cela confirme le droit d’écriture du processus web, pas la réception d’un mail par le collecteur."

msgid "Unchanged"
msgstr "Inchangé"

msgid "Unknown action."
msgstr "Action inconnue."

msgid "Use GLPI theme colors for email text (tickets and followups)"
msgstr "Utiliser les couleurs du thème GLPI pour le texte des mails (tickets et suivis)"

msgid "Use no more than 30 markers and 4096 bytes."
msgstr "Utilisez au maximum 30 marqueurs et 4096 octets."

msgid "Use no more than 50 selectors per list."
msgstr "Utilisez au maximum 50 sélecteurs par liste."

msgid "Version: %s"
msgstr "Version : %s"

msgid "Write a technical log without message bodies"
msgstr "Écrire un journal technique sans le corps des messages"

msgid "Your session has expired or the request is invalid. Reload this page."
msgstr "Votre session a expiré ou la requête est invalide. Rechargez cette page."
